#!/usr/bin/env python3
import math
import sys

def string_to_ascii_list(s):
    ascii_list = []
    for char in s:
        ascii_list.append(ord(char))
    return ascii_list

def create_square_matrix(values):
    size = math.ceil(math.sqrt(len(values)))
    while len(values) < size ** 2:
        values.append(0)
    matrix = []
    for i in range(size):
        matrix.append(values[i * size:(i + 1) * size])
    return matrix

def create_message_matrix(values, key_size):
    rows = math.ceil(len(values) / key_size)
    while len(values) < rows * key_size:
        values.append(0)
    matrix = []
    for i in range(rows):
        matrix.append(values[i * key_size:(i + 1) * key_size])
    return matrix

def matrix_multiply_encrypt(key_matrix, message_matrix):
    key_size = len(key_matrix)
    result = []
    for row in message_matrix:
        new_row = []
        for col in range(key_size):
            value = 0
            for i in range(key_size):
                value += row[i] * key_matrix[i][col]
            new_row.append(value)
        result.append(new_row)
    
    return result

def flatten_matrix(matrix):
    flattened = []
    for row in matrix:
        for item in row:
            flattened.append(item)
    return flattened

def afficher_matrice_alignee_gauche(matrix):
    largeurs_colonnes = []
    for j in range(len(matrix[0])):
        max_largeur = 0
        for i in range(len(matrix)):
            max_largeur = max(max_largeur, len(str(matrix[i][j])))
        largeurs_colonnes.append(max_largeur)
    
    for ligne in matrix:
        ligne_format = ""
        for i, element in enumerate(ligne):
            ligne_format += f"{str(element):<{largeurs_colonnes[i]}}     "
        print(ligne_format.strip())

def afficher_message_chiffre_aligne(message):
    for i, num in enumerate(message):
        if i < len(message) - 1:
            print(f"{num:<1}", end=" ")
        else:
            print(f"{num:<1}")


def main():
    if len(sys.argv) != 4:
        sys.exit(84)
    message = sys.argv[1]
    key = sys.argv[2]
    key_ascii = string_to_ascii_list(key)
    message_ascii = string_to_ascii_list(message)
    key_matrix = create_square_matrix(key_ascii)
    message_matrix = create_message_matrix(message_ascii, len(key_matrix))
    encrypted_matrix = matrix_multiply_encrypt(key_matrix, message_matrix)
    encrypted_message = flatten_matrix(encrypted_matrix)
    
    print("Key matrix:")
    afficher_matrice_alignee_gauche(key_matrix)
    print("\nEncrypted message:")
    afficher_message_chiffre_aligne(encrypted_message)

if __name__ == "__main__":
    main()
